# Base URL of the exam-ai-api backend (no trailing slash), e.g. http://localhost:3001
EXPO_PUBLIC_API_URL=

# Non-secret client key identifying the official mobile app.
# Must match MOBILE_API_KEY configured on exam-ai-api.
EXPO_PUBLIC_MOBILE_API_KEY=

# Google OAuth client IDs for expo-auth-session (from Google Cloud Console).
# Web client ID is also used as the audience the backend verifies the ID token against
# (must match GOOGLE_CLIENT_ID on exam-ai-api).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
